snippetCode["IDE Finder"] := { mode: "C# Class", code: "public static string Run() {`r`n    var ides = new Dictionary<string, string> {`r`n        { `"VS Code`", `"code.exe`" },`r`n        { `"Cursor`", `"Cursor.exe`" },`r`n        { `"Windsurf`", `"Windsurf.exe`" },`r`n        { `"Antigravity IDE`", `"antigravity-ide.exe`" },`r`n        { `"Notepad++`", `"notepad++.exe`" },`r`n        { `"Sublime Text`", `"sublime_text.exe`" },`r`n        { `"Obsidian`", `"Obsidian.exe`" },`r`n        { `"Rider`", `"rider64.exe`" },`r`n        { `"Visual Studio`", `"devenv.exe`" }`r`n    };`r`n    var results = new System.Text.StringBuilder();`r`n    results.AppendLine(`"🔎 Searching for common IDEs & Editors...`");`r`n    foreach (var ide in ides) {`r`n        string path = FindExecutable(ide.Value);`r`n        if (path == null && ide.Key == `"Antigravity IDE`") path = FindExecutable(`"antigravity.exe`");`r`n        if (path != null)`r`n            results.AppendLine(string.Format(`"✓ {0}: {1}`", ide.Key, path));`r`n        else`r`n            results.AppendLine(string.Format(`"✗ {0}: Not Found`", ide.Key));`r`n    }`r`n    return results.ToString();`r`n}`r`n`r`nprivate static string FindExecutable(string exeName) {`r`n    string[] regRoots = { @`"SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\`", @`"SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\App Paths\`" };`r`n    foreach (var root in regRoots) {`r`n        foreach (var hive in new[] { Microsoft.Win32.Registry.CurrentUser, Microsoft.Win32.Registry.LocalMachine }) {`r`n            using (var key = hive.OpenSubKey(root + exeName)) {`r`n                if (key != null) {`r`n                    var val = key.GetValue(`"`") as string;`r`n                    if (!string.IsNullOrEmpty(val) && System.IO.File.Exists(val))`r`n                        return val;`r`n                }`r`n            }`r`n        }`r`n    }`r`n    var pathEnv = Environment.GetEnvironmentVariable(`"PATH`");`r`n    if (!string.IsNullOrEmpty(pathEnv)) {`r`n        foreach (var dir in pathEnv.Split(';')) {`r`n            if (string.IsNullOrEmpty(dir)) continue;`r`n            try {`r`n                var combined = System.IO.Path.Combine(dir.Trim(), exeName);`r`n                if (System.IO.File.Exists(combined)) return combined;`r`n            } catch {}`r`n        }`r`n    }`r`n    var commonDirs = new List<string> {`r`n        Environment.GetFolderPath(Environment.SpecialFolder.ProgramFiles),`r`n        Environment.GetFolderPath(Environment.SpecialFolder.ProgramFilesX86),`r`n        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),`r`n        Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData)`r`n    };`r`n    foreach (var baseDir in commonDirs) {`r`n        if (string.IsNullOrEmpty(baseDir)) continue;`r`n        var specificPaths = new string[] {`r`n            System.IO.Path.Combine(baseDir, @`"Programs\Microsoft VS Code`", exeName),`r`n            System.IO.Path.Combine(baseDir, @`"Programs\cursor`", exeName),`r`n            System.IO.Path.Combine(baseDir, @`"Programs\cursor\resources\app`", exeName),`r`n            System.IO.Path.Combine(baseDir, @`"Programs\Windsurf`", exeName),`r`n            System.IO.Path.Combine(baseDir, @`"Notepad++`", exeName),`r`n            System.IO.Path.Combine(baseDir, @`"Sublime Text 3`", exeName),`r`n            System.IO.Path.Combine(baseDir, @`"Sublime Text`", exeName),`r`n            System.IO.Path.Combine(baseDir, @`"Obsidian`", exeName),`r`n            System.IO.Path.Combine(baseDir, @`"Programs\obsidian`", exeName),`r`n            System.IO.Path.Combine(baseDir, @`"JetBrains\Rider\bin`", exeName),`r`n            System.IO.Path.Combine(baseDir, @`"antigravity-ide`", exeName),`r`n            System.IO.Path.Combine(baseDir, @`"antigravity`", exeName),`r`n            System.IO.Path.Combine(baseDir, @`"Programs\antigravity-ide`", exeName),`r`n            System.IO.Path.Combine(baseDir, @`"Programs\antigravity`", exeName)`r`n        };`r`n        foreach (var sp in specificPaths) {`r`n            if (System.IO.File.Exists(sp)) return sp;`r`n        }`r`n    }`r`n    foreach (var baseDir in commonDirs) {`r`n        if (string.IsNullOrEmpty(baseDir) || !System.IO.Directory.Exists(baseDir)) continue;`r`n        try {`r`n            foreach (var sub in System.IO.Directory.GetDirectories(baseDir)) {`r`n                try {`r`n                    var target = System.IO.Path.Combine(sub, exeName);`r`n                    if (System.IO.File.Exists(target)) return target;`r`n                    foreach (var sub2 in System.IO.Directory.GetDirectories(sub)) {`r`n                        var target2 = System.IO.Path.Combine(sub2, exeName);`r`n                        if (System.IO.File.Exists(target2)) return target2;`r`n                    }`r`n                } catch {}`r`n            }`r`n        } catch {}`r`n    }`r`n    return null;`r`n}" }

snippetCode["Browser Finder"] := { mode: "C# Class", code: "public static string Run() {`r`n    var results = new System.Text.StringBuilder();`r`n    results.AppendLine(`"🌐 Installed Web Browsers:`");`r`n    string regPath = @`"SOFTWARE\Clients\StartMenuInternet`";`r`n    var browsers = new Dictionary<string, string>();`r`n    foreach (var hive in new[] { Microsoft.Win32.Registry.CurrentUser, Microsoft.Win32.Registry.LocalMachine }) {`r`n        using (var key = hive.OpenSubKey(regPath)) {`r`n            if (key == null) continue;`r`n            foreach (var subKeyName in key.GetSubKeyNames()) {`r`n                using (var clientKey = key.OpenSubKey(subKeyName)) {`r`n                    if (clientKey == null) continue;`r`n                    string name = clientKey.GetValue(`"`") as string ?? subKeyName;`r`n                    using (var commandKey = clientKey.OpenSubKey(@`"shell\open\command`")) {`r`n                        if (commandKey == null) continue;`r`n                        string rawPath = commandKey.GetValue(`"`") as string;`r`n                        if (!string.IsNullOrEmpty(rawPath)) {`r`n                            string cleanPath = rawPath.Trim((char)34);`r`n                            if (System.IO.File.Exists(cleanPath) && !browsers.ContainsKey(name)) {`r`n                                browsers[name] = cleanPath;`r`n                            }`r`n                        }`r`n                    }`r`n                }`r`n            }`r`n        }`r`n    }`r`n    if (!browsers.ContainsKey(`"Microsoft Edge`")) {`r`n        string edgePath = System.IO.Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ProgramFilesX86), @`"Microsoft\Edge\Application\msedge.exe`");`r`n        if (System.IO.File.Exists(edgePath)) {`r`n            browsers[`"Microsoft Edge`"] = edgePath;`r`n        }`r`n    }`r`n    foreach (var b in browsers) {`r`n        results.AppendLine(string.Format(`"• {0,-20} -> {1}`", b.Key, b.Value));`r`n    }`r`n    return results.ToString();`r`n}" }

snippetCode["System Quick Info"] := { mode: "C# Class", code: "public static string Run() {`r`n    var sb = new System.Text.StringBuilder();`r`n    sb.AppendLine(`"🖥️  SYSTEM QUICK INFO & ACTIVE DRIVES`");`r`n    sb.AppendLine(`"==================================================`");`r`n    sb.AppendLine(string.Format(`"OS:        {0} ({1}-bit)`", Environment.OSVersion, Environment.Is64BitOperatingSystem ? `"64`" : `"32`"));`r`n    sb.AppendLine(string.Format(`"Machine:   {0}`", Environment.MachineName));`r`n    sb.AppendLine(string.Format(`"Processor: {0} vCPUs`", Environment.ProcessorCount));`r`n    var uptime = TimeSpan.FromMilliseconds((uint)Environment.TickCount);`r`n    sb.AppendLine(string.Format(`"Uptime:    {0:dd}d {0:hh}h {0:mm}m {0:ss}s`", uptime));`r`n    long totalMemory = GC.GetTotalMemory(false);`r`n    sb.AppendLine(string.Format(`"GC Heap:   {0:F2} MB used`", totalMemory / 1024.0 / 1024.0));`r`n    sb.AppendLine(`"\n💾 DRIVE STATUS:`");`r`n    sb.AppendLine(`"--------------------------------------------------`");`r`n    foreach (var drive in System.IO.DriveInfo.GetDrives()) {`r`n        if (!drive.IsReady) continue;`r`n        double totalGB = drive.TotalSize / 1024.0 / 1024.0 / 1024.0;`r`n        double freeGB = drive.AvailableFreeSpace / 1024.0 / 1024.0 / 1024.0;`r`n        double usedGB = totalGB - freeGB;`r`n        double pctUsed = (usedGB / totalGB) * 100;`r`n        int barLength = 15;`r`n        int filled = (int)Math.Round((pctUsed / 100.0) * barLength);`r`n        string bar = new string('█', filled) + new string('░', barLength - filled);`r`n        sb.AppendLine(string.Format(`"{0,-3} [{1}] {2,6:F1}% ({3:F1} GB / {4:F1} GB free)`", drive.Name, bar, pctUsed, freeGB, totalGB));`r`n    }`r`n    sb.AppendLine(`"\n🌐 ACTIVE NETWORK ADAPTERS:`");`r`n    sb.AppendLine(`"--------------------------------------------------`");`r`n    try {`r`n        var adapters = System.Net.NetworkInformation.NetworkInterface.GetAllNetworkInterfaces();`r`n        foreach (var adapter in adapters) {`r`n            if (adapter.OperationalStatus != System.Net.NetworkInformation.OperationalStatus.Up) continue;`r`n            if (adapter.NetworkInterfaceType == System.Net.NetworkInformation.NetworkInterfaceType.Loopback) continue;`r`n            sb.AppendLine(string.Format(`"• {0} ({1})`", adapter.Name, adapter.NetworkInterfaceType));`r`n            var ipProps = adapter.GetIPProperties();`r`n            foreach (var ip in ipProps.UnicastAddresses) {`r`n                if (ip.Address.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork) {`r`n                    sb.AppendLine(string.Format(`"  IP: {0}`", ip.Address));`r`n                }`r`n            }`r`n        }`r`n    } catch (Exception ex) {`r`n        sb.AppendLine(`"Failed to query network interfaces: `" + ex.Message);`r`n    }`r`n    return sb.ToString();`r`n}" }

snippetCode["UIA Notepad Writer"] := { mode: "C# Class", code: "// Reference: System.Windows.Forms.dll;UIAutomationClient.dll;UIAutomationTypes.dll;WindowsBase.dll`r`nusing System;`r`nusing System.Windows.Automation;`r`nusing System.Diagnostics;`r`nusing System.Linq;`r`n`r`npublic static string Run() {`r`n    var sb = new System.Text.StringBuilder();`r`n    sb.AppendLine(`"🤖 Starting Notepad UIA Automation Demo...`");`r`n    var proc = Process.GetProcessesByName(`"notepad`").FirstOrDefault();`r`n    if (proc == null) {`r`n        sb.AppendLine(`"⚠️ Notepad not running! Please open Notepad first and run this script again.`");`r`n        return sb.ToString();`r`n    }`r`n    sb.AppendLine(string.Format(`"✓ Found Notepad (PID: {0})`", proc.Id));`r`n    var winEl = AutomationElement.FromHandle(proc.MainWindowHandle);`r`n    if (winEl == null) {`r`n        sb.AppendLine(`"✗ Failed to get Automation Element from Notepad HWND.`");`r`n        return sb.ToString();`r`n    }`r`n    sb.AppendLine(`"✓ Retrieved Notepad Main Window Element.`");`r`n    var textCond = new PropertyCondition(AutomationElement.ControlTypeProperty, ControlType.Document);`r`n    var editCond = new PropertyCondition(AutomationElement.ClassNameProperty, `"RichEditD2Dpt`");`r`n    var editCondLegacy = new PropertyCondition(AutomationElement.ClassNameProperty, `"Edit`");`r`n    var orCond = new OrCondition(textCond, editCond, editCondLegacy);`r`n    var documentEl = winEl.FindFirst(TreeScope.Children | TreeScope.Descendants, orCond);`r`n    if (documentEl == null) {`r`n        sb.AppendLine(`"✗ Could not find document/text editor area inside Notepad.`");`r`n        return sb.ToString();`r`n    }`r`n    sb.AppendLine(`"✓ Found Notepad text editor area.`");`r`n    object valuePattern;`r`n    if (documentEl.TryGetCurrentPattern(ValuePattern.Pattern, out valuePattern)) {`r`n        var valPat = (ValuePattern)valuePattern;`r`n        valPat.SetValue(`"Hello from AHK# UI Automation!\r\nTime: `" + DateTime.Now.ToString(`"F`"));`r`n        sb.AppendLine(`"✓ Successfully typed text using ValuePattern.SetValue()!`");`r`n    } else {`r`n        sb.AppendLine(`"⚠️ ValuePattern not supported on this element. Trying SendKeys fallback...`");`r`n        documentEl.SetFocus();`r`n        System.Windows.Forms.SendKeys.SendWait(`"Hello from AHK# UIA (Fallback)!{ENTER}`");`r`n        sb.AppendLine(`"✓ Dispatched keys to focused document.`");`r`n    }`r`n    return sb.ToString();`r`n}" }

snippetCode["UIA Studio Inspector"] := { mode: "C# Class", code: "// Reference: UIAutomationClient.dll;UIAutomationTypes.dll;WindowsBase.dll`r`nusing System;`r`nusing System.Windows.Automation;`r`nusing System.Diagnostics;`r`n`r`npublic static string Run() {`r`n    var sb = new System.Text.StringBuilder();`r`n    sb.AppendLine(`"🤖 UI Automation: Listing Studio Elements`");`r`n    sb.AppendLine(`"==================================================`");`r`n    var proc = Process.GetCurrentProcess();`r`n    var winEl = AutomationElement.FromHandle(proc.MainWindowHandle);`r`n    if (winEl == null) {`r`n        sb.AppendLine(`"✗ Failed to get Automation Element from our own HWND.`");`r`n        return sb.ToString();`r`n    }`r`n    sb.AppendLine(string.Format(`"Window: {0}`", winEl.Current.Name));`r`n    sb.AppendLine(`"\n🔍 Listing Top-Level Buttons & Tabs:`");`r`n    sb.AppendLine(`"--------------------------------------------------`");`r`n    var btnCond = new PropertyCondition(AutomationElement.ControlTypeProperty, ControlType.Button);`r`n    var tabCond = new PropertyCondition(AutomationElement.ControlTypeProperty, ControlType.TabItem);`r`n    var textCond = new PropertyCondition(AutomationElement.ControlTypeProperty, ControlType.Text);`r`n    var orCond = new OrCondition(btnCond, tabCond, textCond);`r`n    var elements = winEl.FindAll(TreeScope.Children | TreeScope.Descendants, orCond);`r`n    int count = 0;`r`n    foreach (AutomationElement el in elements) {`r`n        string name = el.Current.Name;`r`n        string type = el.Current.ControlType.ProgrammaticName.Replace(`"ControlType.`", `"`");`r`n        string id = el.Current.AutomationId;`r`n        if (string.IsNullOrEmpty(name) && string.IsNullOrEmpty(id)) continue;`r`n        sb.AppendLine(string.Format(`"• [{0}] Name: \`"{1}\`" | ID: \`"{2}\`"`", type, name, id));`r`n        count++;`r`n        if (count > 25) {`r`n            sb.AppendLine(`"... (showing first 25 elements)`");`r`n            break;`r`n        }`r`n    }`r`n    return sb.ToString();`r`n}" }

snippetCode["Browser Audio Tab Finder"] := { mode: "C# Class", code: '// Reference: UIAutomationClient.dll;UIAutomationTypes.dll;WindowsBase.dll;System.Windows.Forms.dll`r`nusing System;`r`nusing System.Windows.Automation;`r`nusing System.Diagnostics;`r`nusing System.Linq;`r`nusing System.Runtime.InteropServices;`r`n`r`npublic static string Run() {`r`n    var sb = new System.Text.StringBuilder();`r`n    sb.AppendLine("🔍 Searching for browser tabs playing audio...");`r`n    sb.AppendLine("==================================================");`r`n    `r`n    string[] browserNames = { "chrome", "vivaldi", "msedge", "firefox" };`r`n    var browserProcs = Process.GetProcesses()`r`n        .Where(p => browserNames.Contains(p.ProcessName.ToLower()))`r`n        .ToList();`r`n        `r`n    if (browserProcs.Count == 0) {`r`n        return "⚠️ No active browser processes (Chrome, Vivaldi, Edge, Firefox) found.";`r`n    }`r`n    `r`n    bool foundAny = false;`r`n    foreach (var proc in browserProcs) {`r`n        if (proc.MainWindowHandle == IntPtr.Zero) continue;`r`n        `r`n        try {`r`n            var winEl = AutomationElement.FromHandle(proc.MainWindowHandle);`r`n            if (winEl == null) continue;`r`n            `r`n            var cond = new OrCondition(`r`n                new PropertyCondition(AutomationElement.ControlTypeProperty, ControlType.TabItem),`r`n                new PropertyCondition(AutomationElement.ControlTypeProperty, ControlType.Button)`r`n            );`r`n            `r`n            var elements = winEl.FindAll(TreeScope.Descendants, cond);`r`n            foreach (AutomationElement el in elements) {`r`n                string name = el.Current.Name ?? "";`r`n                string type = el.Current.ControlType.ProgrammaticName;`r`n                `r`n                bool isMuteButton = (type.Contains("Button") && `r`n                    (name.IndexOf("Mute tab", StringComparison.OrdinalIgnoreCase) >= 0 ||`r`n                     name.IndexOf("Mute audio", StringComparison.OrdinalIgnoreCase) >= 0 ||`r`n                     name.IndexOf("tab audio", StringComparison.OrdinalIgnoreCase) >= 0));`r`n                     `r`n                bool isTabPlaying = (type.Contains("TabItem") && `r`n                    (name.IndexOf("playing audio", StringComparison.OrdinalIgnoreCase) >= 0 ||`r`n                     name.IndexOf("audio playing", StringComparison.OrdinalIgnoreCase) >= 0));`r`n                     `r`n                if (isMuteButton || isTabPlaying) {`r`n                    foundAny = true;`r`n                    `r`n                    AutomationElement tabItem = el;`r`n                    if (isMuteButton) {`r`n                        var walker = TreeWalker.ControlViewWalker;`r`n                        var parent = walker.GetParent(el);`r`n                        while (parent != null) {`r`n                            if (parent.Current.ControlType == ControlType.TabItem) {`r`n                                tabItem = parent;`r`n                                break;`r`n                            }`r`n                            parent = walker.GetParent(parent);`r`n                        }`r`n                    }`r`n                    `r`n                    string tabName = tabItem.Current.Name;`r`n                    sb.AppendLine(string.Format("🎵 Found active audio in process \`'{0}\`':", proc.ProcessName));`r`n                    sb.AppendLine(string.Format("   Tab Title: \`'{0}\`'", tabName));`r`n                    `r`n                    IntPtr hwnd = proc.MainWindowHandle;`r`n                    if (IsIconic(hwnd)) {`r`n                        ShowWindow(hwnd, SW_RESTORE);`r`n                    }`r`n                    SetForegroundWindow(hwnd);`r`n                    `r`n                    object selectPattern;`r`n                    if (tabItem.TryGetCurrentPattern(SelectionItemPattern.Pattern, out selectPattern)) {`r`n                        ((SelectionItemPattern)selectPattern).Select();`r`n                        sb.AppendLine("   ▶ tab selected and brought to foreground!");`r`n                    } else {`r`n                        tabItem.SetFocus();`r`n                        sb.AppendLine("   ▶ tab focused!");`r`n                    }`r`n                    break;`r`n                }`r`n            }`r`n        } catch { }`r`n    }`r`n    `r`n    if (!foundAny) {`r`n        sb.AppendLine("❌ No tabs playing audio were detected.");`r`n    }`r`n    return sb.ToString();`r`n}`r`n`r`n[DllImport("user32.dll")]`r`nprivate static extern bool SetForegroundWindow(IntPtr hWnd);`r`n`r`n[DllImport("user32.dll")]`r`nprivate static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);`r`n`r`n[DllImport("user32.dll")]`r`nprivate static extern bool IsIconic(IntPtr hWnd);`r`n`r`nprivate const int SW_RESTORE = 9;' }
